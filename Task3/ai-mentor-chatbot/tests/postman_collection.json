{
    "info": {
        "name": "AI Mentor Chatbot",
        "description": "Postman collection for testing the AI Mentor Chatbot API endpoints.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Chat — Send Message",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"message\": \"What is object-oriented programming?\"\n}"
                },
                "url": {
                    "raw": "http://127.0.0.1:5000/api/chat",
                    "host": ["http://127.0.0.1:5000"],
                    "path": ["api", "chat"]
                }
            }
        }
    ]
}
